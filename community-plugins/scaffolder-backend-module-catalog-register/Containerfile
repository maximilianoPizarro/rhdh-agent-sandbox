FROM registry.access.redhat.com/ubi9/nodejs-22:latest AS builder
USER 0
RUN mkdir -p /build && chown 1001:0 /build
USER 1001
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci || npm install
COPY src ./src
COPY tsconfig.json ./
RUN ./node_modules/.bin/tsc --outDir dist --module commonjs --target es2022 --esModuleInterop --skipLibCheck \
    src/index.ts src/module.ts \
    src/actions/createCatalogRegisterEntityAction.ts \
    src/actions/createApplyPendingConfigMapAction.ts 2>&1 \
    && echo '{"main":"dist/index.js"}' > package.json

FROM scratch
COPY --from=builder /build/dist /plugin/dist
COPY --from=builder /build/package.json /plugin/package.json
