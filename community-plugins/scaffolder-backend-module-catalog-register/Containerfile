FROM registry.access.redhat.com/ubi9/nodejs-20:latest AS builder
WORKDIR /build
COPY package.json ./
RUN npm install --omit=dev 2>/dev/null || npm install
COPY src ./src
COPY tsconfig.json ./
RUN npx tsc --outDir dist --module commonjs --target es2022 --esModuleInterop --skipLibCheck \
    src/index.ts src/module.ts \
    src/actions/createCatalogRegisterEntityAction.ts \
    src/actions/createApplyPendingConfigMapAction.ts \
    && echo '{"main":"dist/index.js"}' > package.json

FROM scratch
COPY --from=builder /build/dist /plugin/dist
COPY --from=builder /build/package.json /plugin/package.json
