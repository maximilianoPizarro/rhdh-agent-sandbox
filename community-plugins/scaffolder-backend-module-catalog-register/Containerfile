FROM registry.access.redhat.com/ubi9/nodejs-22:latest AS builder
USER 0
RUN mkdir -p /build /runtime && chown -R 1001:0 /build /runtime
USER 1001
WORKDIR /build
COPY --chown=1001:0 package.json package-lock.json ./
RUN npm ci || npm install
COPY --chown=1001:0 src ./src
COPY --chown=1001:0 tsconfig.json ./
RUN ./node_modules/.bin/tsc --outDir dist --module commonjs --target es2022 --esModuleInterop --skipLibCheck \
    src/index.ts src/module.ts \
    src/actions/createCatalogRegisterEntityAction.ts \
    src/actions/createApplyPendingConfigMapAction.ts \
    src/actions/createWaitForEntityAction.ts \
    src/actions/createRemoveEntityAction.ts \
    src/actions/quoteUnquotedYamlScalars.ts
RUN cd /runtime \
    && printf '{"name":"@internal/plugin-scaffolder-backend-module-catalog-register","version":"0.1.6","main":"dist/index.js","backstage":{"role":"backend-plugin-module"},"dependencies":{"fs-extra":"^11.2.0","yaml":"^2.4.5"}}\n' > package.json \
    && npm install --omit=dev 2>/dev/null \
    && cp -r /build/dist .

FROM scratch
COPY --from=builder /runtime /plugin
