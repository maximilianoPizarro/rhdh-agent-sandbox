*.tgz
# Packaged chart in docs/ for GitHub Pages — keep these
!docs/*.tgz
!docs/index.yaml
# Helm dependency packages (redhat-developer-hub) — helm dependency update only
/charts/
.idea/
.vscode/
# Ship Continue recommendation into DevSpaces scaffolds
!files/**/.vscode/
!files/**/.vscode/extensions.json
*.swp
.DS_Store
tmp/
dist/
# Jekyll local dev build (CI builds into docs/)
_site/
site/
.jekyll-cache/
.sass-cache/
node_modules/
.helm/
# Python bytecode (e.g. from running wire-continue.py locally)
__pycache__/
*.pyc
secrets.env
*.pem
# Continue local configs may contain API keys — never commit
.continue/
**/.continue/config.yaml
# Cursor accidentally copies workspace-storage screenshots into docs/
**/c__Users_*
**/workspaceStorage_*
